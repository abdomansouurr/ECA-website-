{
  "name": "eca-website",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.input.css -o tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i tailwind.input.css -o tailwind.css --watch",
    "bump": "node scripts/bump-version.js",
    "release": "npm run build:css && npm run bump",
    "test:rules": "node scripts/rules-sim.test.js",
    "vendor": "node scripts/vendor.js"
  },
  "devDependencies": {
    "chess.js": "1.4.0",
    "stockfish": "19.0.1",
    "tailwindcss": "3.4.17"
  }
}

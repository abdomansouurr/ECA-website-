rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- دوال مساعدة ----------
    function signedIn()  { return request.auth != null; }
    function notAnon()   { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function isStaff()   { return notAnon() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isAdmin()   { return isStaff() && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin'; }
    // مسح نهائي بضغطة من الأدمن: السيرفر هو اللي بيتأكد إن الـ 30 يوم عدّوا (مش ساعة جهاز الأدمن)
    function purgeable(uid) {
      return isAdmin()
        && exists(/databases/$(database)/documents/deleted/$(uid))
        && get(/databases/$(database)/documents/deleted/$(uid)).data.expiresAt is timestamp
        && request.time > get(/databases/$(database)/documents/deleted/$(uid)).data.expiresAt;
    }
    function hasParentLink(sid) {
      return signedIn() && exists(/databases/$(database)/documents/parentLinks/$(request.auth.uid + '_' + sid));
    }
    // نص آمن: بدون < > " ' ` (حماية من حقن HTML)
    function safeText(v, max) { return v is string && v.size() <= max && v.matches('[^<>"\'`]*'); }
    function nicknameOk(v) {
      return v == '' || (safeText(v, 24) && v.size() >= 2);
    }
    function economyDoc(uid, id) { return /databases/$(database)/documents/users/$(uid)/economy/$(id); }
    function shopCoreSame(o, n) {
      return o.get('titles', []) == n.get('titles', [])
        && o.get('bots', []) == n.get('bots', [])
        && o.get('hints', 0) == n.get('hints', 0);
    }
    function shopValid(s) {
      let titles = s.get('titles', []);
      let bots = s.get('bots', []);
      let hints = s.get('hints', 0);
      return s.keys().hasOnly(['titles','bots','hints','activeTitle'])
        && titles is list && titles.size() <= 3 && titles.hasOnly(['title-tactics','title-knight','title-master'])
        && bots is list && bots.size() <= 7 && bots.hasOnly([1,2,3,4,5,6,7])
        && hints is int && hints >= 0 && hints <= 5000
        && s.get('activeTitle', '') is string
        && (s.get('activeTitle', '') == '' || s.get('activeTitle', '') in titles);
    }
    function protectedEconomySame(o, n) {
      return num(o, 'stars') == num(n, 'stars') && num(o, 'xp') == num(n, 'xp')
        && o.get('missionDate', '') == n.get('missionDate', '')
        && o.get('missionDone', false) == n.get('missionDone', false);
    }
    function shopEquipOk(o, n) {
      return shopValid(n) && shopCoreSame(o, n)
        && (o.get('activeTitle', '') == n.get('activeTitle', '')
          || n.get('activeTitle', '') == ''
          || n.get('activeTitle', '') in o.get('titles', []));
    }
    function puzzleStars(key) {
      return key == 'daily' || key == 'easiest' ? 1
        : key == 'easier' ? 2 : key == 'normal' ? 3 : key == 'harder' ? 4 : key == 'hardest' ? 5 : 0;
    }
    function visionStars(score) {
      return score >= 30 ? 10 : score >= 27 ? 9 : score >= 24 ? 8 : score >= 21 ? 7
        : score >= 18 ? 6 : score >= 15 ? 5 : score >= 12 ? 4 : score >= 9 ? 3
        : score >= 6 ? 2 : score >= 3 ? 1 : 0;
    }
    function economyShopChangeOk(o, n, r) {
      let item = r.get('item', '');
      let titles = o.get('titles', []);
      let newTitles = n.get('titles', []);
      let bots = o.get('bots', []);
      let newBots = n.get('bots', []);
      let hints = o.get('hints', 0);
      let newHints = n.get('hints', 0);
      return shopValid(n) && ((r.kind == 'earn' && shopCoreSame(o, n) && o.get('activeTitle', '') == n.get('activeTitle', ''))
        || (r.kind == 'purchase' && r.starsDelta == -50 && r.xpDelta == 0 && item == 'title-tactics'
            && !(item in titles) && newTitles.size() == titles.size() + 1 && newTitles.hasAll(titles) && item in newTitles
            && newBots == bots && newHints == hints && o.get('activeTitle', '') == n.get('activeTitle', ''))
        || (r.kind == 'purchase' && r.starsDelta == -120 && r.xpDelta == 0 && item == 'title-knight'
            && !(item in titles) && newTitles.size() == titles.size() + 1 && newTitles.hasAll(titles) && item in newTitles
            && newBots == bots && newHints == hints && o.get('activeTitle', '') == n.get('activeTitle', ''))
        || (r.kind == 'purchase' && r.starsDelta == -250 && r.xpDelta == 0 && item == 'title-master'
            && !(item in titles) && newTitles.size() == titles.size() + 1 && newTitles.hasAll(titles) && item in newTitles
            && newBots == bots && newHints == hints && o.get('activeTitle', '') == n.get('activeTitle', ''))
        || (r.kind == 'purchase' && item == 'hint' && r.starsDelta == -20 && r.xpDelta == 0
            && newHints == hints + 1 && newTitles == titles && newBots == bots && o.get('activeTitle', '') == n.get('activeTitle', ''))
        || (r.kind == 'purchase' && r.xpDelta == 0 && r.starsDelta == -20 && item == 'bot-1'
            && !(1 in bots) && newBots.size() == bots.size() + 1 && newBots.hasAll(bots) && 1 in newBots
            && newTitles == titles && newHints == hints && o.get('activeTitle', '') == n.get('activeTitle', ''))
        || (r.kind == 'purchase' && r.xpDelta == 0 && r.starsDelta == -40 && item == 'bot-2'
            && !(2 in bots) && newBots.size() == bots.size() + 1 && newBots.hasAll(bots) && 2 in newBots
            && newTitles == titles && newHints == hints && o.get('activeTitle', '') == n.get('activeTitle', ''))
        || (r.kind == 'purchase' && r.xpDelta == 0 && r.starsDelta == -70 && item == 'bot-3'
            && !(3 in bots) && newBots.size() == bots.size() + 1 && newBots.hasAll(bots) && 3 in newBots
            && newTitles == titles && newHints == hints && o.get('activeTitle', '') == n.get('activeTitle', ''))
        || (r.kind == 'purchase' && r.xpDelta == 0 && r.starsDelta == -100 && item == 'bot-4'
            && !(4 in bots) && newBots.size() == bots.size() + 1 && newBots.hasAll(bots) && 4 in newBots
            && newTitles == titles && newHints == hints && o.get('activeTitle', '') == n.get('activeTitle', ''))
        || (r.kind == 'purchase' && r.xpDelta == 0 && r.starsDelta == -150 && item == 'bot-5'
            && !(5 in bots) && newBots.size() == bots.size() + 1 && newBots.hasAll(bots) && 5 in newBots
            && newTitles == titles && newHints == hints && o.get('activeTitle', '') == n.get('activeTitle', ''))
        || (r.kind == 'purchase' && r.xpDelta == 0 && r.starsDelta == -220 && item == 'bot-6'
            && !(6 in bots) && newBots.size() == bots.size() + 1 && newBots.hasAll(bots) && 6 in newBots
            && newTitles == titles && newHints == hints && o.get('activeTitle', '') == n.get('activeTitle', ''))
        || (r.kind == 'purchase' && r.xpDelta == 0 && r.starsDelta == -300 && item == 'bot-7'
            && !(7 in bots) && newBots.size() == bots.size() + 1 && newBots.hasAll(bots) && 7 in newBots
            && newTitles == titles && newHints == hints && o.get('activeTitle', '') == n.get('activeTitle', ''))
        || (r.kind == 'spend-hint' && hints >= 1 && r.starsDelta == 0 && r.xpDelta == 0 && newHints == hints - 1
            && newTitles == titles && newBots == bots && o.get('activeTitle', '') == n.get('activeTitle', '')));
    }

    // المستوى الابتدائي: Step 1، إلا لو الطالب ربط حسابه بنتيجة اختبار تحديد مستوى معتمدة (plk = مفتاح placementLevels)
    function plOk(d) {
      return d.get('plk', '') == '' ? d.level == 1
        : (d.plk is string && d.plk.matches('[0-9a-f]{64}')
           && exists(/databases/$(database)/documents/placementLevels/$(d.plk))
           && d.level == get(/databases/$(database)/documents/placementLevels/$(d.plk)).data.level);
    }

    function validNewStudent(d) {
      return d.keys().hasOnly(['name','username','email','phone','parentPhone','role','level','group','mode','att','hw','puz','plk','nickname'])
        && d.role == 'student'
        && safeText(d.name, 80) && d.name.size() >= 2
        && nicknameOk(d.get('nickname', ''))
        && d.username is string && d.username.matches('[a-z0-9_]{3,30}')
        && d.email is string && d.email.matches('[^@ ]+@[^@ ]+\\.[^@ ]+') && safeText(d.email, 120)
        && d.phone is string && d.phone.matches('[0-9]{8,15}')
        && d.parentPhone is string && d.parentPhone.matches('[0-9]{8,15}')
        && safeText(d.get('group', ''), 80)
        && plOk(d)
        // الحضور والواجبات والعدّادات بتبدأ فاضية/صفر (الكوتش بس هو اللي يسجّلها، والعدّادات بتزيد بمحاولات مسجّلة)
        && d.get('att', {}) == {} && d.get('hw', {}) == {}
        && d.get('puz', {'t': 0, 'c': 0}) == {'t': 0, 'c': 0};
    }
    // الطالب ممنوع يعدّل الحقول دي في ملفه (الكوتش بس)
    function studentUpdateOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role','username','group','mode','plk','coachName','stuCode','phone','parentPhone','parentCode','note',
          'courseFee','amountPaid','remaining','lastPayDate','lastPayAmount','att','hw'])
        && safeText(request.resource.data.name, 80)
        && safeText(request.resource.data.get('email', ''), 120)
        && nicknameOk(request.resource.data.get('nickname', ''))
        && countersOk() && daysOk() && examOk() && levelOk() && certsOk() && economyUpdateOk();
    }

    function botStars(key) {
      return key == '0' ? 1 : key == '1' ? 2 : key == '2' ? 3 : key == '3' ? 4
        : key == '4' ? 5 : key == '5' ? 6 : key == '6' ? 7 : key == '7' ? 8 : 0;
    }
    function botOwned(key) {
      let bots = resource.data.get('shop', {}).get('bots', []);
      return key == '0' || (key == '1' && 1 in bots) || (key == '2' && 2 in bots)
        || (key == '3' && 3 in bots) || (key == '4' && 4 in bots)
        || (key == '5' && 5 in bots) || (key == '6' && 6 in bots) || (key == '7' && 7 in bots);
    }
    function economyEarnOk(id, r) {
      let a = resource.data.get('arena', {});
      let newA = request.resource.data.get('arena', {});
      return (r.source == 'lesson' && r.key.matches('[1-6]-[0-9]{1,2}')
          && id == 'lesson-' + r.key && resource.data.get('att', {}).get(r.key, false) == true
          && r.starsDelta == 1 && r.xpDelta == 20 && r.missionBonus == false)
        || (r.source == 'puzzle' && r.key in ['daily','easiest','easier','normal','harder','hardest']
          && r.day is string && dateNear(r.day.split('-')) && id == 'puzzle-' + r.day + '-' + r.key
          && r.starsDelta == puzzleStars(r.key) + (r.missionBonus ? 1 : 0)
          && r.xpDelta == puzzleStars(r.key) * 20
          && (r.missionBonus
            ? (a.get('missionDate', '') != r.day && newA.get('missionDate', '') == r.day && newA.get('missionDone', false) == true)
            : (a.get('missionDate', '') == newA.get('missionDate', '') && a.get('missionDone', false) == newA.get('missionDone', false))))
        || (r.source == 'bot' && r.key in ['0','1','2','3','4','5','6','7']
          && r.day is string && dateNear(r.day.split('-')) && id == 'bot-' + r.day + '-' + r.key
          && botOwned(r.key) && r.starsDelta == botStars(r.key) && r.xpDelta == botStars(r.key) * 20 && r.missionBonus == false)
        || (r.source == 'pawn' && r.day is string && r.key == r.day && dateNear(r.day.split('-')) && id == 'pawn-' + r.day
          && r.starsDelta == 2 && r.xpDelta == 40 && r.missionBonus == false)
        || (r.source == 'vision' && r.day is string && r.key == r.day && dateNear(r.day.split('-')) && id == 'vision-' + r.day
          && r.score is int && r.score >= 3 && r.score <= 1000 && r.starsDelta == visionStars(r.score)
          && r.xpDelta == visionStars(r.score) * 20 && r.missionBonus == false);
    }
    function economyUpdateOk() {
      let oldA = resource.data.get('arena', {});
      let newA = request.resource.data.get('arena', {});
      let oldShop = resource.data.get('shop', {});
      let newShop = request.resource.data.get('shop', {});
      let id = request.resource.data.get('lastEconomy', '');
      return (protectedEconomySame(oldA, newA) && shopEquipOk(oldShop, newShop)
          && id == resource.data.get('lastEconomy', ''))
        || (id is string && id.size() > 0 && id != resource.data.get('lastEconomy', '')
          && !exists(economyDoc(request.auth.uid, id)) && existsAfter(economyDoc(request.auth.uid, id))
          && getAfter(economyDoc(request.auth.uid, id)).data.uid == request.auth.uid
          && getAfter(economyDoc(request.auth.uid, id)).data.at == request.time
          && getAfter(economyDoc(request.auth.uid, id)).data.day is string
          && dateNear(getAfter(economyDoc(request.auth.uid, id)).data.day.split('-'))
          && getAfter(economyDoc(request.auth.uid, id)).data.starsDelta is int
          && getAfter(economyDoc(request.auth.uid, id)).data.xpDelta is int
          && num(newA, 'stars') >= 0 && num(newA, 'xp') >= 0
          && num(newA, 'stars') == num(oldA, 'stars') + getAfter(economyDoc(request.auth.uid, id)).data.starsDelta
          && num(newA, 'xp') == num(oldA, 'xp') + getAfter(economyDoc(request.auth.uid, id)).data.xpDelta
          && economyShopChangeOk(oldShop, newShop, getAfter(economyDoc(request.auth.uid, id)).data)
          && (getAfter(economyDoc(request.auth.uid, id)).data.kind == 'earn'
              ? (getAfter(economyDoc(request.auth.uid, id)).data.item == ''
                  && (getAfter(economyDoc(request.auth.uid, id)).data.source == 'vision'
                    || getAfter(economyDoc(request.auth.uid, id)).data.score == 0)
                  && economyEarnOk(id, getAfter(economyDoc(request.auth.uid, id)).data))
              : getAfter(economyDoc(request.auth.uid, id)).data.kind == 'purchase'
                ? (id.matches('buy-' + getAfter(economyDoc(request.auth.uid, id)).data.item + '-[A-Za-z0-9]{8,40}')
                    && getAfter(economyDoc(request.auth.uid, id)).data.source == ''
                    && getAfter(economyDoc(request.auth.uid, id)).data.key == ''
                    && getAfter(economyDoc(request.auth.uid, id)).data.score == 0
                    && getAfter(economyDoc(request.auth.uid, id)).data.missionBonus == false
                    && getAfter(economyDoc(request.auth.uid, id)).data.item in ['title-tactics','title-knight','title-master','hint','bot-1','bot-2','bot-3','bot-4','bot-5','bot-6','bot-7'])
                : (getAfter(economyDoc(request.auth.uid, id)).data.kind == 'spend-hint'
                    && id.matches('hint-use-[A-Za-z0-9]{8,40}')
                    && getAfter(economyDoc(request.auth.uid, id)).data.source == ''
                    && getAfter(economyDoc(request.auth.uid, id)).data.key == ''
                    && getAfter(economyDoc(request.auth.uid, id)).data.item == ''
                    && getAfter(economyDoc(request.auth.uid, id)).data.score == 0
                    && getAfter(economyDoc(request.auth.uid, id)).data.missionBonus == false)));
    }
    function economyReceiptCreateOk(uid, id) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      let beforeA = get(userPath).data.get('arena', {});
      let afterA = getAfter(userPath).data.get('arena', {});
      let r = request.resource.data;
      return notAnon() && request.auth.uid == uid && !exists(/databases/$(database)/documents/deleted/$(uid))
        && r.keys().hasOnly(['uid','kind','source','key','day','item','score','starsDelta','xpDelta','missionBonus','at'])
        && r.uid == uid && r.kind in ['earn','purchase','spend-hint']
        && r.source is string && r.key is string && r.day is string && r.item is string
        && r.score is int && r.starsDelta is int && r.xpDelta is int && r.missionBonus is bool
        && r.at == request.time && getAfter(userPath).data.get('lastEconomy', '') == id
        && num(afterA, 'stars') == num(beforeA, 'stars') + r.starsDelta
        && num(afterA, 'xp') == num(beforeA, 'xp') + r.xpDelta;
    }

    // ================= حماية الألغاز والامتحانات (من غير Cloud Functions) =================
    // كل محاولة لغز/امتحان = وثيقة في attempts رقمها uid_نوع_مفتاح، بتتعمل create بس.
    // عدّادات الطالب ما تزيدش إلا بواحد، ومع محاولة جديدة في نفس العملية → مفيش إعادة ومفيش تزوير أرقام.
    function attDoc(id)  { return /databases/$(database)/documents/attempts/$(id); }
    function num(m, k)   { return m.get(k, 0); }
    function newL()      { return request.resource.data.get('lastAttempt', ''); }
    function oldL()      { return resource.data.get('lastAttempt', ''); }
    // محاولة جديدة من النوع ده اتعملت في نفس العملية، وبعد آخر محاولة بـ 3 ثواني على الأقل
    function newAttempt(kind) {
      return newL() is string
        && newL().matches(request.auth.uid + '_' + kind + '_[A-Za-z0-9-]{1,40}')
        && !exists(attDoc(newL())) && existsAfter(attDoc(newL()))
        && (oldL() == '' || !exists(attDoc(oldL()))
            || request.time > get(attDoc(oldL())).data.at + duration.value(3, 's'));
    }
    function newOk() { return getAfter(attDoc(newL())).data.ok == true; }

    // اللغز اليومي (puz.t / puz.c) وألغاز الساحة (arena.puz*)
    function puzSame(o, n)   { return num(o, 't') == num(n, 't') && num(o, 'c') == num(n, 'c'); }
    function arenaSame(o, n) {
      return num(o, 'puzTried') == num(n, 'puzTried') && num(o, 'puzSolved') == num(n, 'puzSolved')
        && num(o, 'puzStreak') == num(n, 'puzStreak') && num(o, 'puzBestStreak') == num(n, 'puzBestStreak');
    }
    function dailyStep(o, n) {
      return num(n, 't') == num(o, 't') + 1
        && ((newOk() && num(n, 'c') == num(o, 'c') + 1) || (!newOk() && num(n, 'c') == num(o, 'c')));
    }
    function arenaStep(o, n) {
      return num(n, 'puzTried') == num(o, 'puzTried') + 1
        && ((newOk() && num(n, 'puzSolved') == num(o, 'puzSolved') + 1 && num(n, 'puzStreak') == num(o, 'puzStreak') + 1)
            || (!newOk() && num(n, 'puzSolved') == num(o, 'puzSolved') && num(n, 'puzStreak') == 0))
        && num(n, 'puzBestStreak') >= num(o, 'puzBestStreak')
        && (num(n, 'puzBestStreak') == num(o, 'puzBestStreak') || num(n, 'puzBestStreak') == num(n, 'puzStreak'));
    }
    function countersOk() {
      let op = resource.data.get('puz', {});
      let np = request.resource.data.get('puz', {});
      let oa = resource.data.get('arena', {});
      let na = request.resource.data.get('arena', {});
      return (puzSame(op, np) && arenaSame(oa, na))
        || (!puzSame(op, np) && arenaSame(oa, na) && newAttempt('daily') && dailyStep(op, np))
        || (puzSame(op, np) && !arenaSame(oa, na) && newAttempt('arena') && arenaStep(oa, na));
    }

    // أيام التمرين (السلاسل): يوم واحد جديد بس في كل مرة، وتاريخه قريب من النهاردة
    function dateNear(p) {
      return p.size() >= 3 && p[0].matches('[0-9]{4}') && p[1].matches('[0-9]{2}') && p[2].matches('[0-9]{2}')
        && request.time > timestamp.date(int(p[0]), int(p[1]), int(p[2])) - duration.value(1, 'd')
        && request.time < timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(2, 'd');
    }
    // القديم لازم يفضل زي ما هو (ويتشال أقدم يوم بس لما القائمة تكون وصلت 800)
    function daysOk() {
      let od = resource.data.get('arena', {}).get('days', []);
      let nd = request.resource.data.get('arena', {}).get('days', []);
      return nd == od
        || (nd is list && nd.size() >= 1 && nd.size() <= 800
            && ((nd.size() == od.size() + 1 && nd[0:od.size()] == od)
                || (od.size() >= 800 && nd.size() == 800 && nd[0:799] == od[od.size() - 799:od.size()]))
            && nd[nd.size() - 1] is string && nd[nd.size() - 1].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && dateNear(nd[nd.size() - 1].split('-')));
    }

    // الامتحان: بداية (مرة لكل محاولة مسموحة) ← نهاية خلال 20 دقيقة ← طلب إعادة. مفيش رجوع في النتيجة.
    function examStart(k, a, b) {
      return (a.size() == 0 || a.get('status', '') == 'retry')
        && k == string(resource.data.get('level', 1))
        && b.get('status', '') == 'failed' && b.get('score', -1) == 0 && b.get('inProgress', false) == true
        && b.get('attempts', 0) == a.get('attempts', 0) + 1
        && newAttempt('exam')
        && getAfter(attDoc(newL())).data.key == k + '-' + string(b.get('attempts', 0));
    }
    function examInTime(k, a) {
      let id = request.auth.uid + '_exam_' + k + '-' + string(a.get('attempts', 0));
      return exists(attDoc(id)) && request.time < get(attDoc(id)).data.at + duration.value(20, 'm');
    }
    function examEnd(k, a, b) {
      return a.get('inProgress', false) == true && a.get('status', '') == 'failed'
        && b.get('inProgress', false) == false
        && b.get('attempts', 0) == a.get('attempts', 0)
        && b.get('score', -1) is number && b.score >= 0 && b.score <= 100
        && ((b.get('status', '') == 'passed' && b.score >= 70)
            || (b.get('status', '') == 'failed' && b.score < 70 && b.get('reqRetry', false) == false))
        && examInTime(k, a);
    }
    function examFlags(a, b) {
      return a.get('status', '') == 'failed'
        && b.diff(a).affectedKeys().hasOnly(['reqRetry', 'rejected', 'reqDate']);
    }
    function examStepOk(k, o, n) {
      let a = o.get(k, {});
      let b = n.get(k, {});
      return b is map && (examStart(k, a, b) || examEnd(k, a, b) || examFlags(a, b));
    }
    // الطالب بيمتحن في مستواه الحالي بس، فالمفتاح الوحيد المسموح يتغير هو رقم مستواه
    function examOk() {
      let k = string(resource.data.get('level', 1));
      let o = resource.data.get('examState', {});
      let n = request.resource.data.get('examState', {});
      return n.diff(o).affectedKeys().size() == 0
        || (n.diff(o).affectedKeys().hasOnly([k]) && examStepOk(k, o, n));
    }
    // المستوى يزيد واحد بس، ومع نجاح امتحان المستوى ده في نفس العملية
    function passedNow(lv) {
      return request.resource.data.get('examState', {}).get(string(lv), {}).get('status', '') == 'passed'
        && resource.data.get('examState', {}).get(string(lv), {}).get('status', '') != 'passed';
    }
    function levelOk() {
      let ol = resource.data.get('level', 1);
      let nl = request.resource.data.get('level', 1);
      return nl == ol || (nl == ol + 1 && nl <= 6 && passedNow(ol));
    }
    // الشهادات: بتتضاف بس (مفيش تعديل ولا مسح)، وشهادة واحدة مع كل نجاح
    function certsOk() {
      let oc = resource.data.get('certificates', []);
      let nc = request.resource.data.get('certificates', []);
      let ol = resource.data.get('level', 1);
      return nc == oc
        || (nc is list && nc.size() == oc.size() + 1 && nc[0:oc.size()] == oc
            && passedNow(ol) && nc[oc.size()].get('step', 0) == ol
            && nc[oc.size()].get('score', -1) == request.resource.data.examState[string(ol)].score);
    }

    // ---------- أكواد الدعوة (الأدمن بيطلّعها من الموقع، وكل كود يُستخدم مرة واحدة) ----------
    function inviteDoc(code)      { return /databases/$(database)/documents/invites/$(code); }
    function inviteRole(code)     { return get(inviteDoc(code)).data.get('role', 'coach'); }
    // الكود موجود ولسه ما اتستخدمش، وفي نفس العملية بيتعلّم إنه اتستخدم بواسطة نفس الشخص
    function claimsInvite(code) {
      return code is string
        && exists(inviteDoc(code))
        && get(inviteDoc(code)).data.used == false
        && getAfter(inviteDoc(code)).data.used == true
        && getAfter(inviteDoc(code)).data.usedBy == request.auth.uid;
    }

    // ---------- الكوتش والأدمن ----------
    // يتضافوا يدوي من لوحة Firebase، أو بالتسجيل بكود دعوة صالح (الصلاحية = صلاحية الكود بالظبط)
    match /staff/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if notAnon() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role','name','username','invite'])
        && request.resource.data.role in ['coach','admin']
        && safeText(request.resource.data.name, 80)
        && safeText(request.resource.data.username, 40)
        && claimsInvite(request.resource.data.invite)
        && request.resource.data.role == inviteRole(request.resource.data.invite);
      allow update, delete: if false;
    }

    match /invites/{code} {
      allow read:   if isAdmin();
      allow create: if isAdmin()
        && code.matches('[A-Z0-9]{8,16}')
        && request.resource.data.keys().hasOnly(['used','createdBy','createdAt','role'])
        && request.resource.data.used == false
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('role', 'coach') in ['coach','admin'];
      // الاستخدام: مرة واحدة، ومع إنشاء ملف staff لنفس الشخص في نفس العملية
      allow update: if notAnon()
        && resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used','usedBy'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/staff/$(request.auth.uid)).data.invite == code;
      allow delete: if isAdmin();
    }

    // ---------- ملف الطالب ----------
    match /users/{uid} {
      allow read:   if isStaff()
                    || (notAnon() && request.auth.uid == uid && !exists(/databases/$(database)/documents/deleted/$(uid)))
                    || (hasParentLink(uid) && !exists(/databases/$(database)/documents/deleted/$(uid)));
      allow create: if isStaff()
                    || (notAnon() && request.auth.uid == uid
                        && !exists(/databases/$(database)/documents/deleted/$(uid))
                        && validNewStudent(request.resource.data));
      allow update: if isStaff() || (notAnon() && request.auth.uid == uid
                        && !exists(/databases/$(database)/documents/deleted/$(uid)) && studentUpdateOk());
      allow delete: if isAdmin()   // حذف الطالب للأدمن بس
                    || (isStaff() && request.auth.uid == uid);   // والكوتش يمسح ملف الطالب بتاعه هو لما يتحوّل لحساب كوتش

      match /economy/{eid} {
        allow read: if (notAnon() && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/deleted/$(uid))) || purgeable(uid);
        allow create: if economyReceiptCreateOk(uid, eid);
        allow update: if false;
        allow delete: if purgeable(uid);
      }

      match /notifications/{nid} {
        allow get, list: if (notAnon() && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/deleted/$(uid))) || purgeable(uid);
        allow create: if (isStaff()
            && exists(/databases/$(database)/documents/users/$(uid))
            && !exists(/databases/$(database)/documents/deleted/$(uid))
            && nid.matches('[A-Za-z0-9_-]{1,120}')
            && request.resource.data.keys().hasOnly(['type','titleAr','titleEn','bodyAr','bodyEn','createdAt','read'])
            && request.resource.data.type in ['homework','announcement']
            && safeText(request.resource.data.titleAr, 100)
            && safeText(request.resource.data.titleEn, 100)
            && safeText(request.resource.data.bodyAr, 400)
            && safeText(request.resource.data.bodyEn, 400)
            && request.resource.data.createdAt == request.time
            && request.resource.data.read == false)
          || (notAnon() && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/deleted/$(uid))
            && nid.matches('daily-puzzle-[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && request.resource.data.keys().hasOnly(['type','day','titleAr','titleEn','bodyAr','bodyEn','createdAt','read'])
            && request.resource.data.type == 'daily_puzzle'
            && request.resource.data.day is string
            && nid == 'daily-puzzle-' + request.resource.data.day
            && dateNear(request.resource.data.day.split('-'))
            && request.resource.data.titleAr == 'لغز اليوم الجديد جاهز'
            && request.resource.data.titleEn == "Today's new puzzle is ready"
            && request.resource.data.bodyAr == 'افتح الصفحة الرئيسية وحل لغز اليوم.'
            && request.resource.data.bodyEn == "Open the home page and solve today's puzzle."
            && request.resource.data.createdAt == request.time
            && request.resource.data.read == false);
        allow update: if notAnon() && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/deleted/$(uid))
          && resource.data.read == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt'])
          && request.resource.data.read == true
          && request.resource.data.readAt == request.time;
        allow delete: if isStaff();
      }
    }

    // ---------- دفتر المحاولات (create فقط — مفيش تعديل، والمسح للكوتش بس) ----------
    match /attempts/{id} {
      allow read:   if isStaff() || (notAnon() && resource.data.uid == request.auth.uid) || hasParentLink(resource.data.uid);
      allow create: if notAnon()
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'key', 'ok', 'at', 'step'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['arena', 'daily', 'exam']
        && request.resource.data.key is string && request.resource.data.key.matches('[A-Za-z0-9-]{1,40}')
        && id == request.auth.uid + '_' + request.resource.data.kind + '_' + request.resource.data.key
        && request.resource.data.ok is bool
        && request.resource.data.at == request.time
        && (request.resource.data.kind != 'daily' || dateNear(request.resource.data.key.split('-')))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('lastAttempt', '') == id;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- البطولات الداخلية (الكوتش بيكتب، وأي حساب مسجّل بيقرا) ----------
    function validTournament(d) {
      return d.keys().hasOnly(['name','format','double','totalRounds','status','createdAt','finishedAt','date','players','rounds'])
        && safeText(d.name, 80)
        && d.format in ['rr','swiss'] && d.status in ['running','done']
        && d.players is list && d.players.size() >= 3 && d.players.size() <= 64
        && d.rounds is list && d.rounds.size() <= 70
        && d.totalRounds is number && d.totalRounds >= 1 && d.totalRounds <= 70;
    }
    match /tournaments/{tid} {
      allow read: if notAnon();
      allow create, update: if isStaff() && tid.matches('[A-Za-z0-9]{4,40}') && validTournament(request.resource.data);
      allow delete: if isStaff();
    }

    // ---------- سجل الأخطاء (أي حساب يكتب خطأ، والأدمن بس يقرا ويمسح) ----------
    match /errors/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['msg','src','line','ua','uid','at','ver','tab'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 500
        && request.resource.data.get('src', '') is string && request.resource.data.get('src', '').size() <= 300
        && request.resource.data.get('ua', '') is string && request.resource.data.get('ua', '').size() <= 300
        && request.resource.data.get('ver', '') is string && request.resource.data.get('ver', '').size() <= 20
        && request.resource.data.get('tab', '') is string && request.resource.data.get('tab', '').size() <= 30
        && request.resource.data.get('line', 0) is int;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---------- الملاحظة السرية + كود ولي الأمر (الطالب ما يقراهاش) ----------
    match /private/{sid} {
      allow read:  if isStaff() || hasParentLink(sid);
      allow write: if isStaff();
    }

    // ---------- المالية (الأدمن فقط) ----------
    match /finance/{sid} {
      allow read, write: if isAdmin();
    }

    // ---------- الحضور (يوم = وثيقة) ----------
    match /attendance/{day} {
      allow read, write: if isStaff();
    }

    // ---------- المجموعات ----------
    match /meta/{id} {
      allow read:  if notAnon();
      allow write: if isStaff();
    }

    // ---------- أكواد ولي الأمر: القراءة بالـ get فقط (ممنوع تعمل list فتعرف الأكواد) ----------
    match /parentCodes/{code} {
      allow get:   if signedIn();
      allow list:  if false;
      allow write: if isStaff();
    }
    match /parentLinks/{linkId} {
      allow read:   if isStaff() || (signedIn() && linkId.matches(request.auth.uid + '_.*'));
      allow create, update: if signedIn()
        && linkId == request.auth.uid + '_' + request.resource.data.sid
        && exists(/databases/$(database)/documents/parentCodes/$(request.resource.data.code))
        && get(/databases/$(database)/documents/parentCodes/$(request.resource.data.code)).data.sid == request.resource.data.sid;
      allow delete: if isStaff();
    }

    // ---------- حذف منطقي للطلاب: الاستعادة متاحة لحد المسح النهائي، والمسح النهائي بيتفتح بعد 30 يومًا ----------
    match /deleted/{uid} {
      allow get: if isAdmin() || (notAnon() && request.auth.uid == uid);
      allow list: if isStaff();
      allow create: if isAdmin()
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasOnly(['deletedAt','expiresAt','name','by'])
        && request.resource.data.keys().hasAll(['deletedAt','expiresAt','name','by'])
        && request.resource.data.deletedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd')
        && safeText(request.resource.data.name, 80)
        && request.resource.data.by == request.auth.uid;
      // بعد المسح النهائي الوثيقة بتفضل تمنع الدخول بالحساب، من غير الاسم
      allow update: if isAdmin() && resource.data.expiresAt is timestamp
        && request.time > resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','purgedAt'])
        && request.resource.data.name == ''
        && request.resource.data.purgedAt == request.time;
      allow delete: if isAdmin() && resource.data.get('purgedAt', null) == null;
    }

    // ---------- المستوى المعتمد من اختبار تحديد المستوى ----------
    // المفتاح = SHA-256 لرقم الطالب + رقم ولي الأمر (مفيش اسم ولا رقم في الوثيقة). الطالب بيعمل get بس، ومفيش list،
    // فلازم يعرف الرقمين. الكوتش هو اللي يكتب/يمسح عند اعتماد أو إعادة فتح الاختبار.
    match /placementLevels/{key} {
      allow get: if notAnon();
      allow list: if false;
      allow create, update: if isStaff() && key.matches('[0-9a-f]{64}')
        && request.resource.data.keys().hasOnly(['level', 'at'])
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 6;
      allow delete: if isStaff();
    }

    // ---------- اختبار تحديد المستوى ----------
    // الطالب (دخول مجهول من نسخة placement): ينشئ وثيقة واحدة بمفتاح رقم موبايله (create فقط)، ويكمّل إجاباته طالما in_progress،
    // وبعد done مفيش تعديل منه. القراءة والاعتماد والحذف (إعادة الفتح) للكوتش/الأدمن فقط.
    // النتيجة بتتعرض للكوتش، فلازم تكون أرقام مش نص
    function placementResultOk(d, total) {
      return d.answers is map && d.answers.size() <= total
        && d.get('score', 0) is number && d.get('score', 0) >= 0 && d.get('score', 0) <= 100
        && d.get('correct', 0) is number && d.get('correct', 0) >= 0 && d.get('correct', 0) <= total
        && d.get('suggested', 1) is number && d.get('suggested', 1) >= 1 && d.get('suggested', 1) <= 6
        && d.get('finishedAt', 0) is number;
    }
    match /placementTests/{id} {
      allow read:   if isStaff() || (signedIn() && resource.data.owner == request.auth.uid);
      allow create: if signedIn() && id.matches('[0-9]{8,15}')
        && request.resource.data.keys().hasOnly(['name','age','phone','parentPhone','rating','link','mode','owner','status','createdAt','answers','total','lk'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.phone == id
        && safeText(request.resource.data.name, 80)
        && request.resource.data.age is number && request.resource.data.age >= 3 && request.resource.data.age <= 99
        && request.resource.data.parentPhone is string && request.resource.data.parentPhone.matches('[0-9]{8,15}')
        && safeText(request.resource.data.rating, 20)
        && safeText(request.resource.data.link, 200)
        && (request.resource.data.link == '' || request.resource.data.link.matches('https://.*'))
        && request.resource.data.mode in ['online','offline']
        && request.resource.data.total == 20
        && request.resource.data.answers.size() == 0
        && request.resource.data.get('lk', '') is string
        && (request.resource.data.get('lk', '') == '' || (request.resource.data.lk.matches('[0-9a-f]{64}')
            && existsAfter(/databases/$(database)/documents/placementLocks/$('l_' + request.resource.data.lk))))
        && existsAfter(/databases/$(database)/documents/placementLocks/$('u_' + request.auth.uid));
      allow update: if isStaff()
        || (signedIn() && resource.data.owner == request.auth.uid && resource.data.status == 'in_progress'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers','status','score','correct','suggested','finishedAt'])
            && request.resource.data.status in ['in_progress','done']
            && placementResultOk(request.resource.data, resource.data.total));
      allow delete: if isStaff();
    }
    // أقفال منع إعادة الاختبار (جهاز / حساب شطرنج): تتكتب مرة واحدة فقط مع وثيقة الاختبار، والكوتش بس هو اللي يمسحها (إعادة الفتح)
    match /placementLocks/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['owner','t'])
        && request.resource.data.owner == request.auth.uid
        && (key == 'u_' + request.auth.uid || key.matches('l_[0-9a-f]{64}'));
      allow update: if false;
      allow delete: if isStaff();
    }
    // النسخ الاحتياطية للتقارير (تتحذف تلقائياً بعد 30 يوم: فعّل TTL على الحقل expireAt)
    match /placementReports/{id} {
      allow read, delete: if isStaff();
      allow create: if isStaff() && request.resource.data.keys().hasOnly(['createdAt','expireAt','by','count','rows'])
        && request.resource.data.expireAt is timestamp && request.resource.data.by == request.auth.uid;
      allow update: if false;
    }
  }
}
